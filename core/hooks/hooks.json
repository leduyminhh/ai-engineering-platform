{
  "description": "Cổng an toàn nền của ai-engineering-platform: git, file bí mật, phạm vi ghi của agent.",
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash|PowerShell", "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-bash.mjs"], "timeout": 10 } ] },
      { "matcher": "Read|Grep|Edit|Write|MultiEdit|NotebookEdit", "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-files.mjs"], "timeout": 10 } ] }
    ],
    "Stop":         [ { "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/gate-stop.mjs"], "timeout": 10 } ] } ],
    "SubagentStop": [ { "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/gate-stop.mjs"], "timeout": 10 } ] } ]
  }
}
